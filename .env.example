# AIST Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control

# LLM API key for AIST response analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Target agent API key if authentication is required
TARGET_API_KEY=your_target_agent_api_key_here

# SIEM integration (optional)
SIEM_ENDPOINT=
SIEM_API_KEY=

# Scan settings
MAX_SCANS_PER_HOUR=10
MAX_PAYLOAD_RUNS=3
RESPONSE_SIZE_LIMIT_KB=500
SCAN_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

# Output paths
REPORTS_DIR=reports
LOGS_DIR=logs
