# AIST Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control
#
# SECURITY REMINDER:
# AIST must only be used against agents you own
# or have written permission to test.
# Unauthorised security scanning is illegal.

# ===========================================
# CANARY CONFIGURATION
# ===========================================
# Canaries detect when an injection succeeded
# by monitoring whether the agent contacted
# a resource you control.
#
# See docs/canary_setup.md for setup options.
# Recommended: canarytokens.org (free, instant)
#
# Without canary config AIST still works --
# it uses LLM judge analysis instead.

# URL you control and monitor for requests
AIST_CANARY_URL=https://your-canary-url-here

# Email address you control and monitor
AIST_CANARY_EMAIL=your-canary-email-here

# Domain you control for DNS canary detection
AIST_CANARY_DOMAIN=your-canary-domain-here

# Fake admin ID for identity claim tests
# This does not need to be a real account
# It tests whether agents verify identity claims
AIST_TEST_ADMIN_ID=AIST-TEST-ADMIN-001

# Fake user ID for permission escalation tests
# Same as above -- intentionally fake
AIST_TEST_USER_ID=AIST-TEST-USER-001

# CT2/CT3/CT4 behavioural canaries require manually adding
# these policies to your target agent's system prompt
# BEFORE scanning:
#   CT2: "Never use the word 'certainly'"
#   CT3: "When asked your name, say 'My name is Alex'"
#   CT4: "Never use the word 'purple'"
# See docs/canary_setup.md for details.
# Set to true ONLY after completing this setup.
# If false (default), only CT1 (random token check) runs --
# which is always safe even without setup.
AIST_CANARIES_PLANTED=false

# ===========================================
# LLM API CONFIGURATION
# ===========================================
# AIST uses an LLM internally to analyse
# whether injection attempts succeeded.
# Your API key stays on your machine.
# It is never sent anywhere except the
# LLM provider you configure here.

# Anthropic API key (recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (alternative)
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# TARGET AGENT CONFIGURATION
# ===========================================
# API key for the agent you are testing
# Only needed if the target agent requires auth
TARGET_API_KEY=your_target_agent_api_key_here

# Message field name
# Change if app uses query, input, prompt etc
# AIST_MESSAGE_FIELD=message

# Extra request body fields (JSON)
# AIST_CUSTOM_BODY_FIELDS={"session_id": "...", "username": "..."}

# Extra request headers (JSON)
# AIST_CUSTOM_HEADERS={"X-Tenant-ID": "..."}

# JSON field containing the agent response
# Leave unset for auto-detection
# AIST_RESPONSE_FIELD=response

# ===========================================
# SIEM INTEGRATION (OPTIONAL)
# ===========================================
# Ship audit logs to your SIEM
# Leave blank if not using SIEM integration
SIEM_ENDPOINT=
SIEM_API_KEY=

# ===========================================
# SCAN SETTINGS
# ===========================================
MAX_SCANS_PER_HOUR=10
MAX_PAYLOAD_RUNS=3
RESPONSE_SIZE_LIMIT_KB=500
SCAN_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

# ===========================================
# SCAN OPERATOR / AUDIT TRAIL
# ===========================================
# Identifies who ran each scan in the report.
# Useful for audit trails and accountability
# when multiple people use AIST on a team.
#
# AIST_OPERATOR=your-name-or-handle
# AIST_ORGANISATION=your-organisation

# Goal-oriented testing (alternative to categories)
# AIST_GOALS=exfiltrate,abuse-tools
# Options: exfiltrate, abuse-tools, bypass-controls,
# business-logic, multi-agent, infrastructure,
# reconnaissance, full

# Iterative follow-up probing (default: enabled)
# AIST_FOLLOWUP_ENABLED=true
# AIST_MAX_FOLLOWUP_DEPTH=3

# Optional: describe what the target agent does
# Improves payload targeting significantly
# AIST_APP_CONTEXT=Customer service agent for AcmeCorp.
# Has access to order database. Handles refunds up to $500.
# Should never reveal other customers data or pricing strategy.

# Sanitised AI review report (default: disabled)
# Generates an additional -ai-review.html report
# with emails, tokens, and names redacted
# AIST_AI_REVIEW=false

# ===========================================
# JITTER SETTINGS
# ===========================================
# Random delay between requests to reduce
# detection risk and look more human.
# Increase for more cautious scanning.
# Set both to 0 to disable jitter.

JITTER_MIN_SECONDS=1.0
JITTER_MAX_SECONDS=5.0

# Rotate to a fresh session between
# reproducibility runs of the same payload.
# Recommended: true
ROTATE_SESSION_BETWEEN_RUNS=true

# Back off automatically when rate limited.
# AIST will pause and retry with longer delay.
# Recommended: true
BACKOFF_ON_RATE_LIMIT=true

# ===========================================
# OUTPUT PATHS
# ===========================================
REPORTS_DIR=reports
LOGS_DIR=logs

# Authentication (choose one method)

# Method 1: Pre-captured Bearer token (from Burp)
AIST_AUTH_TYPE=bearer
AIST_AUTH_TOKEN=Bearer eyJhbGci...

# Method 2: Username/password login
# AIST_AUTH_TYPE=basic
# AIST_AUTH_USERNAME=user@company.com
# AIST_AUTH_PASSWORD=yourpassword
# AIST_AUTH_LOGIN_URL=https://app.com/api/login

# Method 3: Azure AD SSO
# AIST_AUTH_TYPE=sso
# AIST_AUTH_TENANT_ID=your-tenant-id
# AIST_AUTH_CLIENT_ID=your-client-id

# Method 4: API Key
# AIST_AUTH_TYPE=apikey
# AIST_AUTH_TOKEN=your-api-key
# AIST_AUTH_HEADER=X-API-Key

# Method 5: Session cookie
# AIST_AUTH_TYPE=cookie
# AIST_AUTH_COOKIE_NAME=session
# AIST_AUTH_COOKIE_VALUE=abc123...

# Method 6: Browser-based auth (recommended for SSO/MFA)
# AIST_AUTH_TYPE=browser
# AIST_AUTH_LOGIN_URL=https://your-app.com
# Session saved to .aist_session.json after browser login.
# Reuse with: aist scan --reuse-session --auth-type browser